{
  "name": "@workspace/claim-constructor",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Source-linked, AI-assisted patent claim interpretation with inspectable text and drawing evidence.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/core/contracts.ts",
    "./server": "./src/server/router.ts",
    "./quota": "./src/server/quota.ts",
    "./ui": "./src/ui/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
